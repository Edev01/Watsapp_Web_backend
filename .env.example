PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/whatsapp_web
JWT_SECRET=change_me

# Baileys WhatsApp worker (same host in Contabo)
WORKER_BASE_URL=http://127.0.0.1:4100
WORKER_API_KEY=change-me-to-a-long-random-secret

# AI pipeline: local (in-process, default) | remote (legacy AI_BOT_URL) | off
AI_PIPELINE=local

# Together AI (Qwen — cascade stage 2)
LLM_BASE_URL=https://api.together.ai/v1
LLM_API_KEY=your_together_api_key
DEFAULT_MODEL=Qwen/Qwen3.5-9B
NORMALIZE_MODEL=Qwen/Qwen3.5-9B

# Gemini (cascade stage 1 — primary). Comma-separated keys rotate on 429/quota.
# GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
# Or numbered: GEMINI_API_KEY_1=... GEMINI_API_KEY_2=...
# Models rotate on 502/5xx (loop forever, not one-shot):
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-flash-8b,gemini-2.5-flash

# Normalization is OpenAI gpt-4o-mini only. NER, gazetteers, and geocoding are not used.
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email when scripts/renormalize.js stops (uses SMTP_* below)
# RENORMALIZE_QUOTA_ABORT_STREAK=12

# Free geocode refine (legacy cascade only — extract-v2 does NOT call this).
# Photon/Nominatim often invent wrong Pakistan places ("Kot Kamboh" from "Bug Garden").
# Prefer false unless you know you need OSM fill on the old normalizer path.
GEOCODE_ENABLED=false
GEOCODE_USER_AGENT=PropSyncPropertyNormalizer/1.0 (contact: you@example.com)

# Used only when the LLM left phase empty. Geocodes the place and stores
# the phase name Google returns (for example "Phase 6"). Does not override
# a phase written in the WhatsApp message.
GOOGLE_MAPS_API_KEY=

# Ollama embeddings (same host or reachable URL)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# Concurrency / resilience
NORMALIZE_CONCURRENCY=8
NORMALIZE_PER_USER=4
EMBED_CONCURRENCY=3
LLM_MAX_RETRIES=6
CLAIM_STALE_SECONDS=900
JOB_STALE_SECONDS=1800
PIPELINE_POLL_MS=15000
NORMALIZE_BATCH_SIZE=50

# Legacy only when AI_PIPELINE=remote
# AI_BOT_URL=https://your-python-ml-host
# NORMALIZE_SERVICE_SECRET=

# Safepay (sandbox or production). Public key starts with sec_.
# Without SAFEPAY_PLAN_ID, checkout charges PKR 7000 once per month via our billing cycle.
# SAFEPAY_ENV=sandbox
# SAFEPAY_ENVIRONMENT=sandbox
# SAFEPAY_API_KEY=sec_...
# SAFEPAY_V1_SECRET=
# SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_PLAN_ID=plan_...
# FRONTEND_URL=https://propsync-delta.vercel.app
