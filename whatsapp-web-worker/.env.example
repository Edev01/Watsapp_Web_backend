BACKEND_API_URL=https://watsapp-web-backend.onrender.com
# Comma-separated portal user ids to scrape via WhatsApp Web (pilot: Danish = 4)
WEB_USER_IDS=4
SESSIONS_DIR=./sessions
# Sticky residential/datacenter proxy (single IP). Leave empty to use Contabo egress.
PROXY_URL=
# Hourly backfill window in hours
BACKFILL_HOURS=6
# How many messages to pull per chat when backfilling (then filter by time)
BACKFILL_FETCH_LIMIT=500
# Cron: every hour at :05
BACKFILL_CRON=5 * * * *
# Chromium path on Contabo (after apt install chromium-browser or google-chrome)
PUPPETEER_EXECUTABLE_PATH=
LOG_LEVEL=info
PORT=4200
